{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile inside the bypass app",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "email": { "type": "string" },
        "name": { "type": "string" },
        "role": { "type": "string" }
      },
      "required": ["userId", "email", "name", "role"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Information about registered users of the app"
    }
  }
}
